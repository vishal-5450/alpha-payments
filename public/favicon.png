<!-- Features start -->
<section id="service" class="service">
	<div class="container">
		<div class="row">
			<div class="col-md-4 col-sm-4 wow fadeInDown" data-wow-delay=".5s">
				<div class="service-content">
					<!-- <span class="service-image"><img class="img-fluid" src="images/pages/service-1.jpg" alt="" /></span> -->
					<span class="service-image"><img class="img-fluid" style="height: 200px;width: 350px;" src="images/service1_new.webp" alt="" /></span>
					<div class="service_image_title"><br>EFT SWITCHING SERVICES</div>
					<p align="justify">Wide range of experience in deploying EFT Switch Solution and providing related services to Financial Institute. Expertise caters around Switches like ACI's Base24 Classic, Base24 EPS, Postilion, UP etc.
						</p>
				</div>
			</div>
			<!--/ End first service -->

			<div class="col-md-4 col-sm-4 wow fadeInDown" data-wow-delay=".8s">
				<div class="service-content">
					<!-- <span class="service-image"><img class="img-fluid" src="images/pages/service-2.jpg" alt="" /></span> -->
					<span class="service-image"><img class="img-fluid" style="height: 200px;width: 350px;" src="images/service2_new.webp" alt="" /></span>
					<div class="service_image_title"><br>BANKING AUTOMATION</div>
					<p align="justify">Automation is the focus of interest in the global banking industry. Alpha payments helps to deploy latest automation technologies to deliver the next wave of productivity, cost saving and improved customer experience. Alpha Payments has experts in various financial simulators like FinSim, VISA Simulator, MDS, MAS etc.</p>
				</div>

			</div>
			<!--/ End Second features -->

			<div class="col-md-4 col-sm-4 wow fadeInDown" data-wow-delay="1.1s">
				<div class="service-content">
					<!-- <span class="service-image"><img class="img-fluid" src="images/pages/service-3.jpg" alt="" /></span> -->
					<span class="service-image"><img class="img-fluid" style="height: 200px;width: 350px;" src="images/service3_new.webp" alt="" /></span>
					<div class="service_image_title"><br>ADVISORY SERVICES</div>
					<p align="justify">As a leading digital transformation provider, Alpha Payments relentlessly pushes the envelope and develop innovative strategies and solutions that help its customer make most of your technology investments to drive competitive advantage.
						</p>
				</div>
			</div>
			<!--/ End Third features -->
		</div><!-- Content Row end --> <br>
	</div>
