# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
# Public site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://alphapay.co.in

# ---------------------------------------------------------------------------
# E-mail — Resend (preferred; works on Render free tier over HTTPS)
# ---------------------------------------------------------------------------
# Create a key at https://resend.com/api-keys
# Verify your domain (alphapay.co.in) under Domains, then set MAIL_FROM to that domain.
# Until the domain is verified, you can test with: MAIL_FROM="Alpha Payments <onboarding@resend.dev>"
# (Resend only delivers onboarding@ mail to your Resend account e-mail.)
RESEND_API_KEY=

# Optional SMTP fallback (local / paid hosts). Ignored when RESEND_API_KEY is set.
# Render *free* blocks SMTP ports 25/465/587 — do not rely on SMTP in production there.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

MAIL_FROM="Alpha Payments Website <noreply@alphapay.co.in>"
# Recipient override. Leave empty in production to use the HR e-mail managed in the console.
MAIL_TO=

# ---------------------------------------------------------------------------
# HR master console (hidden at /console)
# ---------------------------------------------------------------------------
CONSOLE_USER=hr
# Wrap the value in quotes if it contains # or spaces.
CONSOLE_PASSWORD="change-me-to-a-long-random-password"
# 32+ random characters; signs the login cookie. Generate: openssl rand -hex 32
CONSOLE_SECRET=

# ---------------------------------------------------------------------------
# Postgres (HR console content: contact info + careers)
# ---------------------------------------------------------------------------
# Prefer Supabase *shared pooler* (IPv4). Direct db.PROJECT.supabase.co is IPv6-only
# and fails on Render with ENETUNREACH (Render has no IPv6 egress).
# Session (recommended for Next.js): aws-0-REGION.pooler.supabase.com:5432
# Username must be USER.PROJECT_REF (e.g. alpha_app.cyahgmgcypvlfifkpmst)
DATABASE_URL=
