# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
# Public site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://alphapay.co.in

# ---------------------------------------------------------------------------
# E-mail (Gmail / Google Workspace SMTP)
# ---------------------------------------------------------------------------
# The mailbox that sends form notifications. Use a Google *App Password*
# (Google Account -> Security -> 2-Step Verification -> App passwords), never the login password.
# When SMTP_USER / SMTP_PASS are empty, submissions are logged to the server console instead.
SMTP_USER=info@alphapay.co.in
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# From address. Must be SMTP_USER or a verified "Send mail as" alias of it, otherwise Gmail rewrites it.
MAIL_FROM="Alpha Payments Website <info@alphapay.co.in>"

# Recipient override. Leave empty in production to use the HR e-mail managed in the console.
# For testing: MAIL_TO=vishal.Ugalmugale@alphapay.co.in
MAIL_TO=

# ---------------------------------------------------------------------------
# HR master console (hidden at /console)
# ---------------------------------------------------------------------------
CONSOLE_USER=hr
# Wrap the value in quotes if it contains # or spaces.
CONSOLE_PASSWORD="change-me-to-a-long-random-password"
# 32+ random characters; signs the login cookie. Generate: openssl rand -hex 32
CONSOLE_SECRET=

# Where editable content (contact info, jobs) is stored. Defaults to ./data.
# On Render/Vercel point this to a persistent disk, e.g. /var/data
CONTENT_DIR=
